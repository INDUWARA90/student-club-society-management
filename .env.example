# Copy this file to .env (repo root, for docker compose) and to backend/.env
# (for running the backend directly via ./mvnw), then fill in real values.
# Never commit the real .env files.

DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=generate-a-long-random-string-here
FRONTEND_URL=http://localhost:5173

# Leave blank until you set up email sending (Gmail: enable 2FA, then
# generate an App Password at myaccount.google.com > Security > App Passwords).
MAIL_USERNAME=
MAIL_PASSWORD=
