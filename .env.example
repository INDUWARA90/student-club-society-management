# Copy this file to .env (and to backend/.env if running the backend outside Docker),
# then fill in real values.

DB_USERNAME=root
DB_PASSWORD=changeme

JWT_SECRET=change-this-to-a-long-random-string

FRONTEND_URL=http://localhost:5173

# SMTP credentials for Spring Mail (e.g. a Gmail app password)
MAIL_USERNAME=
MAIL_PASSWORD=
