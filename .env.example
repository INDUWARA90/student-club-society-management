# Used ONLY by `docker compose up` (copy to .env in the repo root). Running the apps directly uses
# backend/.env.example and frontend/.env.example instead.
MYSQL_ROOT_PASSWORD=changeme
DB_USERNAME=club_app
DB_PASSWORD=changeme
JWT_SECRET=replace-with-a-long-random-secret

# Frontend URL accessed by browsers
FRONTEND_URL=http://localhost:8080

# Allowed origins for CORS and WebSocket handshake (comma-separated, supports wildcards).
# When deploying to Azure / Cloud VM:
# Either set to "*" to allow any client host, OR include your VM IP and port:
# e.g.: CORS_ALLOWED_ORIGINS=http://20.244.107.128:8080,http://20.244.107.128,http://localhost:8080
CORS_ALLOWED_ORIGINS=*

# API base URL for frontend build (must point to backend port 5000)
# In deployment: http://<YOUR_VM_IP>:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# --- Outbound Email (SMTP) Configuration ---
# Default is Google Gmail SMTP over port 587 (STARTTLS).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# For Gmail, MAIL_USERNAME is your full email address (e.g., student.hub@gmail.com)
MAIL_USERNAME=
# IMPORTANT FOR GMAIL: You CANNOT use your regular Google account password.
# You MUST generate an App Password:
# 1. Open Google Account (https://myaccount.google.com/security)
# 2. Enable 2-Step Verification
# 3. Go to Security -> 2-Step Verification -> App passwords (at bottom)
# 4. Create password named "Club Portal", copy the 16 letters (e.g., abcd efgh ijkl mnop)
MAIL_PASSWORD=
# Custom From header (defaults to MAIL_USERNAME if omitted)
APP_MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Alternative SMTP Provider Examples:
# SendGrid:
#   MAIL_HOST=smtp.sendgrid.net
#   MAIL_PORT=587
#   MAIL_USERNAME=apikey
#   MAIL_PASSWORD=<YOUR_SENDGRID_API_KEY>
#
# Mailgun:
#   MAIL_HOST=smtp.mailgun.org
#   MAIL_PORT=587
#   MAIL_USERNAME=postmaster@your-domain.mailgun.org
#   MAIL_PASSWORD=<YOUR_MAILGUN_PASSWORD>

# --- Deployment safety switches (see backend/src/main/resources/application.yml) ---
# Local/demo stack defaults: demo data on, email verification not enforced. The database schema is created and
# upgraded by Flyway migrations (backend/src/main/resources/db/migration) - leave JPA_DDL_AUTO=validate.
# For a real deployment use: SEED_DEMO_DATA=false, REQUIRE_EMAIL_VERIFICATION=true, and set BOOTSTRAP_ADMIN_*
# to create the first Super Admin (password >= 12 chars; ignored once any Super Admin exists).
SEED_DEMO_DATA=true
JPA_DDL_AUTO=validate
REQUIRE_EMAIL_VERIFICATION=false
# Only true behind a proxy that overwrites X-Forwarded-For (needed for correct per-IP rate limiting there).
TRUST_FORWARDED_HEADERS=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Database backups (compose "backup" service): dump interval in seconds (default daily) and how many to keep
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14
