# Backend settings. Copy this file to backend/.env and fill in real values (backend/.env is git-ignored).
# The app reads backend/.env automatically when started from the backend folder (./mvnw spring-boot:run,
# ./mvnw test, or java -jar). A real environment variable always wins over a value in this file.
# The frontend has its own file: frontend/.env.example.

# --- Local development (default "dev" profile) ------------------------------------------------------------------
# Local MySQL user; the club_management database is created on first start and Flyway builds the schema.
DB_USERNAME=root
DB_PASSWORD=changeme
# Any long random string (32+ characters).
JWT_SECRET=replace-with-a-long-random-secret
# Where the frontend runs; used in e-mail links and QR codes.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Gmail address + app password (optional locally; without them e-mails are just logged as failed).
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional switches (defaults shown).
SEED_DEMO_DATA=true
REQUIRE_EMAIL_VERIFICATION=false

# --- Production (SPRING_PROFILES_ACTIVE=prod) -------------------------------------------------------------------
# On Render/Docker set these as environment variables instead of using a file. See docs/DEPLOYMENT.md.
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:mysql://HOST:PORT/DBNAME?sslMode=REQUIRED&serverTimezone=UTC
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# SEED_DEMO_DATA=false
# REQUIRE_EMAIL_VERIFICATION=true
# TRUST_FORWARDED_HEADERS=true      # only behind a proxy that overwrites X-Forwarded-For (e.g. Render)
# BOOTSTRAP_ADMIN_EMAIL=            # first start only: creates the initial Super Admin (password 12+ characters)
# BOOTSTRAP_ADMIN_PASSWORD=
