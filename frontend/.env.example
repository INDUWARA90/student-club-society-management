# Frontend settings. Copy this file to frontend/.env (git-ignored). Vite reads it automatically.
# Values here are baked into the public JavaScript bundle, so never put secrets in this file.
# The backend has its own file: backend/.env.example.

# Backend API address, including /api.
#   local backend:  http://localhost:5000/api
#   deployed:       https://YOUR-BACKEND.onrender.com/api   (on Vercel set this as an environment variable instead)
VITE_API_BASE_URL=http://localhost:5000/api
